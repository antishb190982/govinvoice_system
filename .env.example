# Copy to .env and fill in. Never commit .env.
GOVBILLS_ENV=production
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=govbills.example.gov
DJANGO_CSRF_TRUSTED_ORIGINS=https://govbills.example.gov
SITE_URL=https://govbills.example.gov
# Fernet key(s) for bank details and signing keys; prepend a new key to rotate.
FIELD_ENCRYPTION_KEYS=        # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIGNING_CA_PASSPHRASE=        # long random passphrase protecting the internal CA key
SIGNING_CA_NAME=GovBills Internal Signing CA
SIGNING_ORGANISATION=Government Shared Services
SIGNING_COUNTRY=OM
SIGNING_TSA_URL=              # optional RFC 3161 timestamp authority -> PAdES B-T
SIGNING_EXTRA_TRUST_ROOTS=    # comma-separated PEM paths, e.g. national PKI root
POSTGRES_DB=govbills
POSTGRES_USER=govbills
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
TIME_ZONE=Asia/Muscat
DEFAULT_CURRENCY=OMR
WORK_WEEK_DAYS=6,0,1,2,3      # Monday=0 … Sunday=6 (here: Sunday–Thursday)
WORK_DAY_START_HOUR=7
WORK_DAY_END_HOUR=15
SETTLEMENT_LEAD_DAYS=3
DUE_SOON_DAYS=7
ANOMALY_THRESHOLD_PCT=30
PAYER_NAME=Ministry of Finance
PAYER_IBAN=
PAYER_BIC=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.gov
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=govbills@example.gov
ADMIN_URL_PATH=sysadmin-change-me/
SESSION_IDLE_TIMEOUT_MINUTES=15
